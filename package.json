{
  "name": "@local/chat-lite",
  "version": "1.0.0",
  "private": true,
  "description": "Lean chat + machine-status profile: a sidebar page switches between chat mode (short prompt, per-call web approval) and normal mode, with one switch per tool.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
